
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="windows-1252">
    <meta http-equiv="Content-Language" content="pt-br">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
    <meta name="theme-color" content="#971b2f">
    <title>Combate ao Assédio Eleitoral - Centrais Sindicais</title>
    <link rel="shortcut icon" href="elei.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        :root {
            --primary: #971b2f;
            --primary-dark: #741224;
            --primary-soft: #fff0f3;
            --accent: #d8a22a;
            --ink: #19212e;
            --muted: #667085;
            --line: #e4e7ec;
            --surface: #ffffff;
            --page: #f4f6f8;
            --success: #147a4b;
            --success-soft: #ecfdf3;
            --danger: #b42318;
            --danger-soft: #fff2f0;
            --shadow: 0 18px 50px rgba(16, 24, 40, .10);
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            color: var(--ink);
            background:
                radial-gradient(circle at 8% 4%, rgba(151, 27, 47, .09), transparent 26rem),
                radial-gradient(circle at 92% 14%, rgba(216, 162, 42, .10), transparent 22rem),
                var(--page);
            font-family: "Inter", Arial, sans-serif;
            line-height: 1.55;
        }
        a { color: inherit; }
        button, input, textarea { font: inherit; }

        .topbar {
            height: 6px;
            background: linear-gradient(90deg, var(--primary-dark), var(--primary), var(--accent));
        }
        .page-shell {
            width: min(480px, calc(100% - 18px));
            margin: 0 auto;
        }
        .site-header {
            padding: 24px 0 12px;
        }
        .brand {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }
        .brand img {
            display: block;
            width: min(480px, 72vw);
            max-height: 110px;
            object-fit: contain;
            object-position: left center;
        }
        .security-badge {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: var(--success);
            background: var(--success-soft);
            border: 1px solid #abefc6;
            border-radius: 999px;
            padding: 9px 14px;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
        }

        .hero {
            display: grid;
            grid-template-columns: 1.04fr .96fr;
            gap: 28px;
            align-items: stretch;
            margin: 14px 0 28px;
        }
        .hero-copy, .hero-side {
            border-radius: 24px;
            overflow: hidden;
            box-shadow: var(--shadow);
        }
        .hero-copy {
            position: relative;
            padding: clamp(28px, 5vw, 54px);
            color: #fff;
            background:
                linear-gradient(135deg, rgba(116, 18, 36, .98), rgba(151, 27, 47, .92)),
                linear-gradient(45deg, transparent, rgba(255,255,255,.08));
        }
        .hero-copy:after {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            right: -95px;
            bottom: -100px;
            border: 40px solid rgba(255,255,255,.07);
            border-radius: 50%;
        }
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 18px;
            color: #ffe8a8;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
        }
        .hero h1 {
            max-width: 720px;
            margin: 0 0 16px;
            font-size: clamp(31px, 5vw, 52px);
            line-height: 1.05;
            letter-spacing: -.035em;
        }
        .hero-copy p {
            max-width: 660px;
            margin: 0;
            color: rgba(255,255,255,.88);
            font-size: 16px;
        }
        .hero-links {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 26px;
        }
        .hero-link {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 11px 15px;
            color: #fff;
            border: 1px solid rgba(255,255,255,.28);
            border-radius: 12px;
            background: rgba(255,255,255,.09);
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            transition: .2s ease;
        }
        .hero-link:hover { background: rgba(255,255,255,.17); transform: translateY(-1px); }

        .hero-image-block {
            grid-column: 1 / -1;
            width: 100%;
        }
        .hero-main-image {
            display: block;
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            border-radius: 24px;
            box-shadow: var(--shadow);
        }
        .hero-image-text {
            margin: 18px 6px 0;
            color: var(--ink);
            font-size: 14px;
            line-height: 1.40;
        }
        .hero-image-block .hero-links {
            margin: 16px 6px 0;
        }
        .hero-link-new {
            color: #fff;
            background: var(--primary);
            border-color: var(--primary);
        }
        .hero-link-new:hover {
            background: var(--primary-dark);
            border-color: var(--primary-dark);
        }

        .hero-side {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1px;
            background: var(--line);
        }
        .benefit {
            min-height: 155px;
            padding: 26px;
            background: var(--surface);
        }
        .benefit i {
            display: grid;
            width: 42px;
            height: 42px;
            place-items: center;
            margin-bottom: 15px;
            color: var(--primary);
            background: var(--primary-soft);
            border-radius: 12px;
            font-size: 18px;
        }
        .benefit strong { display: block; margin-bottom: 4px; font-size: 15px; }
        .benefit span { color: var(--muted); font-size: 13px; line-height: 1.45; }

        .content-card {
            margin: 0 0 36px;
            border: 1px solid rgba(228,231,236,.9);
            border-radius: 24px;
            background: rgba(255,255,255,.97);
            box-shadow: var(--shadow);
            overflow: hidden;
        }
        .form-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 24px 30px;
            border-bottom: 1px solid var(--line);
            background: linear-gradient(180deg, #fff, #fcfcfd);
        }
        .form-head h2 { margin: 0; font-size: 22px; letter-spacing: -.02em; }
        .form-head p { margin: 5px 0 0; color: var(--muted); font-size: 14px; }
        .step-indicator {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }
        .step-indicator span {
            width: 27px;
            height: 5px;
            border-radius: 99px;
            background: #d0d5dd;
        }
        .step-indicator span:first-child { background: var(--primary); }

        .alert {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin: 24px 30px 0;
            padding: 14px 16px;
            border-radius: 13px;
            font-size: 14px;
        }
        .alert-error { color: var(--danger); background: var(--danger-soft); border: 1px solid #fecdca; }
        .alert i { margin-top: 3px; }

        .form-section {
            padding: 30px;
            border-bottom: 1px solid var(--line);
        }
        .section-title {
            display: flex;
            align-items: flex-start;
            gap: 13px;
            margin-bottom: 23px;
        }
        .section-icon {
            display: grid;
            flex: 0 0 42px;
            width: 42px;
            height: 42px;
            place-items: center;
            color: var(--primary);
            background: var(--primary-soft);
            border-radius: 12px;
        }
        .section-title h3 { margin: 0; font-size: 18px; }
        .section-title p { margin: 3px 0 0; color: var(--muted); font-size: 13px; }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 19px; }
        .field-full { grid-column: 1 / -1; }
        .field label {
            display: block;
            margin-bottom: 7px;
            font-size: 13px;
            font-weight: 700;
        }
        .optional { color: #98a2b3; font-weight: 500; }
        .input-wrap { position: relative; }
        .input-wrap > i {
            position: absolute;
            left: 15px;
            top: 50%;
            color: #98a2b3;
            transform: translateY(-50%);
            pointer-events: none;
        }
        .input-wrap.textarea > i { top: 18px; transform: none; }
        .control {
            width: 100%;
            min-height: 48px;
            padding: 11px 14px 11px 43px;
            color: var(--ink);
            background: #fff;
            border: 1px solid #d0d5dd;
            border-radius: 11px;
            outline: none;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }
        textarea.control {
            min-height: 180px;
            padding-top: 13px;
            resize: vertical;
            line-height: 1.55;
        }
        .control:hover { border-color: #98a2b3; }
        .control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(151, 27, 47, .10);
        }
        .control::placeholder { color: #98a2b3; }
        .help { margin: 7px 0 0; color: var(--muted); font-size: 12px; }

        .privacy-box {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 22px;
            padding: 14px 16px;
            border: 1px solid #fedf89;
            border-radius: 13px;
            background: #fffaeb;
        }
        .privacy-box input { width: 18px; height: 18px; margin: 2px 0 0; accent-color: var(--primary); }
        .privacy-box label { cursor: pointer; }
        .privacy-box strong { display: block; font-size: 14px; }
        .privacy-box span { display: block; margin-top: 2px; color: #7a5b12; font-size: 12px; }

        .upload-zone {
            position: relative;
            padding: 30px;
            text-align: center;
            border: 2px dashed #c8cdd5;
            border-radius: 17px;
            background: #fafbfc;
            transition: .2s ease;
        }
        .upload-zone.dragging { border-color: var(--primary); background: var(--primary-soft); }
        .upload-zone .upload-main-icon {
            display: grid;
            width: 58px;
            height: 58px;
            place-items: center;
            margin: 0 auto 14px;
            color: var(--primary);
            background: var(--primary-soft);
            border-radius: 17px;
            font-size: 23px;
        }
        .upload-zone h4 { margin: 0 0 6px; font-size: 16px; }
        .upload-zone p { margin: 0 auto 18px; color: var(--muted); font-size: 13px; }
        .upload-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 9px; }
        .file-input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
        .upload-button, .mini-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 42px;
            padding: 9px 14px;
            border: 1px solid #d0d5dd;
            border-radius: 10px;
            background: #fff;
            color: #344054;
            cursor: pointer;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            transition: .2s ease;
        }
        .upload-button.primary { color: #fff; border-color: var(--primary); background: var(--primary); }
        .upload-button:hover, .mini-button:hover { transform: translateY(-1px); box-shadow: 0 5px 14px rgba(16,24,40,.09); }
        .file-summary {
            display: none;
            margin-top: 16px;
            text-align: left;
        }
        .file-summary.visible { display: block; }
        .file-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
        .file-item {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 12px;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: #fff;
        }
        .file-item > i { width: 24px; color: var(--primary); text-align: center; }
        .file-meta { min-width: 0; flex: 1; }
        .file-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; font-weight: 700; }
        .file-size { display: block; color: var(--muted); font-size: 11px; }
        .file-tools { display: flex; justify-content: flex-end; margin-top: 10px; }
        .mini-button { min-height: 34px; padding: 6px 10px; color: var(--danger); }
        .formats {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 14px;
        }
        .format-pill {
            padding: 5px 8px;
            color: #475467;
            background: #f2f4f7;
            border-radius: 7px;
            font-size: 11px;
            font-weight: 700;
        }

        .form-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 24px 30px;
            background: #fcfcfd;
        }
        .submit-note { display: flex; align-items: center; gap: 9px; color: var(--muted); font-size: 12px; }
        .submit-note i { color: var(--success); }
        .submit-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-width: 190px;
            min-height: 50px;
            padding: 12px 22px;
            color: #fff;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border: 0;
            border-radius: 12px;
            box-shadow: 0 10px 20px rgba(151,27,47,.22);
            cursor: pointer;
            font-weight: 800;
            transition: .2s ease;
        }
        .submit-button:hover { transform: translateY(-1px); box-shadow: 0 13px 26px rgba(151,27,47,.28); }
        .submit-button:disabled { opacity: .7; cursor: wait; transform: none; }

        .success-card {
            padding: clamp(32px, 6vw, 72px) 28px;
            text-align: center;
        }
        .success-icon {
            display: grid;
            width: 78px;
            height: 78px;
            place-items: center;
            margin: 0 auto 22px;
            color: var(--success);
            background: var(--success-soft);
            border: 1px solid #abefc6;
            border-radius: 50%;
            font-size: 32px;
        }
        .success-card h2 { margin: 0 0 12px; font-size: clamp(26px, 4vw, 38px); letter-spacing: -.03em; }
        .success-card p { max-width: 660px; margin: 0 auto; color: var(--muted); font-size: 15px; }
        .success-name { color: var(--primary); }
        .success-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 26px; }
        .secondary-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 15px;
            color: #344054;
            background: #fff;
            border: 1px solid #d0d5dd;
            border-radius: 10px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
        }

        .faq-card { padding: 30px; }
        .faq-header { margin-bottom: 22px; }
        .faq-header h2 { margin: 0 0 8px; font-size: clamp(25px, 4vw, 36px); letter-spacing: -.03em; }
        .faq-header p { margin: 0; color: var(--muted); }
        details {
            border-top: 1px solid var(--line);
        }
        details:last-of-type { border-bottom: 1px solid var(--line); }
        summary {
            position: relative;
            padding: 19px 42px 19px 0;
            cursor: pointer;
            list-style: none;
            font-weight: 700;
        }
        summary::-webkit-details-marker { display: none; }
        summary:after {
            content: "+";
            position: absolute;
            right: 7px;
            top: 50%;
            width: 25px;
            height: 25px;
            line-height: 23px;
            text-align: center;
            color: var(--primary);
            border: 1px solid #e8b6c0;
            border-radius: 50%;
            transform: translateY(-50%);
        }
        details[open] summary:after { content: "-"; }
        .faq-answer { padding: 0 45px 20px 0; color: #475467; font-size: 14px; }
        .faq-answer p { margin: 0 0 10px; }
        .faq-answer ul { margin: 8px 0 0; padding-left: 20px; }

        .support-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin: 0 0 32px;
            padding: 22px 25px;
            color: #fff;
            background: #172033;
            border-radius: 18px;
        }
        .support-copy { display: flex; align-items: center; gap: 14px; }
        .support-icon {
            display: grid;
            flex: 0 0 44px;
            width: 44px;
            height: 44px;
            place-items: center;
            background: rgba(255,255,255,.1);
            border-radius: 12px;
            font-size: 20px;
        }
        .support-copy strong { display: block; }
        .support-copy span { display: block; margin-top: 2px; color: #cbd5e1; font-size: 12px; }
        .whatsapp-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            color: #06351f;
            background: #86efac;
            border-radius: 10px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 800;
            white-space: nowrap;
        }
        .footer {
            padding: 0 0 28px;
            color: #667085;
            text-align: center;
            font-size: 11px;
        }


        /* Mantém o formato de celular também no computador */
        .hero {
            display: block;
            margin: 14px 0 22px;
        }
        .hero-copy {
            border-radius: 19px;
            padding: 30px 23px;
        }
        .grid-2 {
            grid-template-columns: 1fr;
        }
        .field-full {
            grid-column: auto;
        }
        .upload-actions {
            flex-direction: column;
        }
        .upload-button {
            width: 100%;
        }
        .form-footer {
            flex-direction: column-reverse;
            align-items: stretch;
        }
        .submit-button {
            width: 100%;
        }
        .support-card {
            align-items: stretch;
            flex-direction: column;
        }
        .whatsapp-button {
            justify-content: center;
        }
        .step-indicator {
            display: none;
        }
        .footer-logos {
            margin-top: 12px;
            padding: 8px 0 0;
        }
        .footer-logos img {
            display: block;
            width: 100%;
            height: auto;
            background: #fff;
        }

        @media (max-width: 820px) {
            .hero { grid-template-columns: 1fr; }
            .hero-side { grid-template-columns: repeat(4, 1fr); }
            .benefit { min-height: auto; padding: 19px; }
            .grid-2 { grid-template-columns: 1fr; }
            .field-full { grid-column: auto; }
        }
        @media (max-width: 650px) {
            .page-shell { width: min(100% - 20px, 1120px); }
            .site-header { padding-top: 15px; }
            .brand { justify-content: center; }
            .brand img { width: min(420px, 92vw); object-position: center; }
            .security-badge { display: none; }
            .hero { gap: 14px; margin-top: 7px; }
            .hero-copy { border-radius: 19px; padding: 30px 23px; }
            .hero-side { grid-template-columns: 1fr 1fr; border-radius: 19px; }
            .benefit { padding: 18px; }
            .content-card { border-radius: 19px; margin-bottom: 22px; }
            .form-head, .form-section, .form-footer, .faq-card { padding-left: 19px; padding-right: 19px; }
            .form-head { align-items: flex-start; }
            .step-indicator { display: none; }
            .alert { margin-left: 19px; margin-right: 19px; }
            .upload-zone { padding: 24px 14px; }
            .upload-actions { flex-direction: column; }
            .upload-button { width: 100%; }
            .form-footer { flex-direction: column-reverse; align-items: stretch; }
            .submit-button { width: 100%; }
            .submit-note { justify-content: center; text-align: center; }
            .support-card { align-items: stretch; flex-direction: column; }
            .whatsapp-button { justify-content: center; }
        }
    </style>
</head>
<body>
<div class="topbar"></div>
<main class="page-shell">

    <section class="hero">
        <div class="hero-image-block">
            <img class="hero-main-image" src="asseeleitoral.png" alt="Denuncie o Assédio Eleitoral no trabalho">
            <p class="hero-image-text">Use este canal da Centrais Sindicais para relatar pressões, ameaças, constrangimentos ou vantagens oferecidas para interferir no seu livre direito de voto.</p>
            <div class="hero-links">
                <a class="hero-link hero-link-new" href="/ae/index.asp?seq=2"><i class="fa-regular fa-circle-question"></i> Como identificar o Assédio Eleitoral</a>
            </div>
        </div>
    </section>

    <section class="content-card" id="formulario">
    
        <div class="form-head">
            <div>
                <h2>Faça sua Denúncia</h2>
                <p>Preencha todos os campos que puder.</p>
            </div>
            <div class="step-indicator" aria-label="Etapas do formulário"><span></span><span></span><span></span> 3 etapas</div>
        </div>

        

        <form method="post" enctype="multipart/form-data" action="/ae/index.asp?seq=1" id="denunciaForm" novalidate>
            <section class="form-section">
                <div class="section-title">
                    <div class="section-icon"><i class="fa-regular fa-user"></i></div>
                    <div><h3>1. Dados do denunciante</h3><p>Esses campos são opcionais. Preencha os meios pelos quais deseja receber retorno.</p></div>
                </div>

                <div class="privacy-box">
                    <input type="checkbox" id="sigilo" name="sigilo" value="S">
                    <label for="sigilo"><strong>Manter meus dados em sigilo</strong><span>Marque esta opção para solicitar proteção da sua identidade durante o tratamento da denúncia.</span></label>
                </div>

                <div class="grid-2">
                    <div class="field">
                        <label for="nome">Nome completo <span class="optional">(opcional)</span></label>
                        <div class="input-wrap"><i class="fa-regular fa-id-card"></i><input class="control" type="text" id="nome" name="nome" maxlength="150" autocomplete="name" value="" placeholder="Digite seu nome"></div>
                    </div>
                    <div class="field">
                        <label for="mail">E-mail <span class="optional">(opcional)</span></label>
                        <div class="input-wrap"><i class="fa-regular fa-envelope"></i><input class="control" type="email" id="mail" name="mail" maxlength="150" autocomplete="email" value="" placeholder="nome@exemplo.com"></div>
                    </div>
                    <div class="field">
                        <label for="fone">Telefone com DDD <span class="optional">(opcional)</span></label>
                        <div class="input-wrap"><i class="fa-solid fa-phone"></i><input class="control" type="tel" id="fone" name="fone" maxlength="15" inputmode="tel" autocomplete="tel" value="" placeholder="(18) 99999-9999"></div>
                    </div>
                    <div class="field">
                        <label for="sind">Sindicato que representa você <span class="optional">(opcional)</span></label>
                        <div class="input-wrap"><i class="fa-solid fa-people-group"></i><input class="control" type="text" id="sind" name="sind" maxlength="180" value="" placeholder="Nome do sindicato"></div>
                    </div>
                </div>
            </section>

            <section class="form-section">
                <div class="section-title">
                    <div class="section-icon"><i class="fa-regular fa-building"></i></div>
                    <div><h3>2. Dados da denúncia</h3><p>Identifique o local e descreva, com clareza, o que aconteceu.</p></div>
                </div>

                <div class="grid-2">
                    <div class="field">
                        <label for="entid">Empresa ou entidade denunciada *</label>
                        <div class="input-wrap"><i class="fa-regular fa-building"></i><input class="control" type="text" id="entid" name="entid" maxlength="180" value="" placeholder="Nome da empresa ou entidade" required></div>
                    </div>
                    <div class="field">
                        <label for="cnpj">CNPJ <span class="optional">(opcional)</span></label>
                        <div class="input-wrap"><i class="fa-solid fa-hashtag"></i><input class="control" type="text" id="cnpj" name="cnpj" maxlength="18" inputmode="numeric" value="" placeholder="00.000.000/0000-00"></div>
                    </div>
                    <div class="field field-full">
                        <label for="cident">Cidade/UF onde ocorreram os fatos *</label>
                        <div class="input-wrap"><i class="fa-solid fa-location-dot"></i><input class="control" type="text" id="cident" name="cident" maxlength="120" value="" placeholder="Ex.: Presidente Prudente/SP" required></div>
                    </div>
                    <div class="field field-full">
                        <label for="relato">Relato da denúncia *</label>
                        <div class="input-wrap textarea"><i class="fa-regular fa-pen-to-square"></i><textarea class="control" id="relato" name="relato" maxlength="12000" placeholder="Informe o máximo de detalhes: local, setor, data, horário, nomes, funções, como ocorreu a pressão e se houve testemunhas..." required></textarea></div>
                        <p class="help">Evite inserir informações sem relação com os fatos.</p>
                    </div>
                </div>
            </section>

            <section class="form-section">
                <div class="section-title">
                    <div class="section-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
                    <div><h3>3. Provas e anexos</h3><p>Você pode enviar até 4 arquivos. Cada arquivo pode ter até 100 MB e o total até 200 MB.</p></div>
                </div>

                <div class="upload-zone" id="uploadZone">
                    <div class="upload-main-icon"><i class="fa-solid fa-file-arrow-up"></i></div>
                    <h4>Adicione arquivos que ajudem a comprovar os fatos</h4>
                    <p>Selecione arquivos do aparelho ou use os atalhos de câmera, áudio e vídeo.</p>

                    <div class="upload-actions">
                        <label class="upload-button primary" for="arquivos"><i class="fa-solid fa-folder-open"></i> Selecionar arquivos</label>
                        <label class="upload-button" for="foto"><i class="fa-solid fa-camera"></i> Tirar foto</label>
                        <label class="upload-button" for="audio"><i class="fa-solid fa-microphone"></i> Gravar áudio</label>
                        <label class="upload-button" for="video"><i class="fa-solid fa-video"></i> Gravar vídeo</label>
                    </div>

                    <input class="file-input" type="file" id="arquivos" name="F1" multiple accept="image/jpeg,image/png,image/gif,image/webp,image/heic,image/heif,image/bmp,audio/*,video/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.rtf,.csv,.odt,.ods,.odp">
                    <input class="file-input" type="file" id="foto" name="F2" accept="image/*" capture="environment">
                    <input class="file-input" type="file" id="audio" name="F3" accept="audio/*" capture>
                    <input class="file-input" type="file" id="video" name="F4" accept="video/*" capture="environment">

                    <div class="file-summary" id="fileSummary">
                        <ul class="file-list" id="fileList"></ul>
                        <div class="file-tools"><button class="mini-button" type="button" id="clearFiles"><i class="fa-regular fa-trash-can"></i> Limpar anexos</button></div>
                    </div>
                </div>
                <div class="formats" aria-label="Formatos permitidos">
                    <span class="format-pill"><i class="fa-regular fa-image"></i> JPG, PNG, WEBP, HEIC</span>
                    <span class="format-pill"><i class="fa-solid fa-headphones"></i> MP3, WAV, M4A</span>
                    <span class="format-pill"><i class="fa-solid fa-film"></i> MP4, MOV, WEBM</span>
                    <span class="format-pill"><i class="fa-regular fa-file-lines"></i> PDF, Word, Excel e outros</span>
                </div>
            </section>

            <div class="form-footer">
                <div class="submit-note"><i class="fa-solid fa-shield-halved"></i> Confira as informações antes de enviar.</div>
                <button class="submit-button" type="submit" id="submitButton"><i class="fa-solid fa-paper-plane"></i> Enviar denúncia</button>
            </div>
        </form>
    
    </section>


    <section class="support-card">
        <div class="support-copy">
            <div class="support-icon"><i class="fa-brands fa-whatsapp"></i></div>
            <div><strong>Precisa de ajuda para preencher?</strong><span>Nossa equipe está à disposição pelo WhatsApp.</span></div>
        </div>
        <a class="whatsapp-button" href="https://wa.me/5518996010106" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp"></i> Fale pelo Whatsapp</a>
    </section>
</main>

<footer class="footer page-shell">
    <div>Centrais Sindicais - Canal de combate ao assédio eleitoral nas relações de trabalho.</div>
    <div class="footer-logos">
        <img src="data:image/png;base64," alt="Centrais Sindicais">
    </div>
</footer>

<script>
(function () {
    var form = document.getElementById('denunciaForm');
    if (!form) return;

    var fileInputs = [
        document.getElementById('arquivos'),
        document.getElementById('foto'),
        document.getElementById('audio'),
        document.getElementById('video')
    ];
    var fileSummary = document.getElementById('fileSummary');
    var fileList = document.getElementById('fileList');
    var clearFiles = document.getElementById('clearFiles');
    var uploadZone = document.getElementById('uploadZone');
    var relato = document.getElementById('relato');
    var submitButton = document.getElementById('submitButton');
    var phone = document.getElementById('fone');
    var cnpj = document.getElementById('cnpj');
    var maxFiles = 4;
    var maxEach = 100 * 1024 * 1024;
    var maxTotal = 200 * 1024 * 1024;

    function allFiles() {
        var files = [];
        fileInputs.forEach(function (input) {
            if (!input || !input.files) return;
            Array.prototype.forEach.call(input.files, function (file) { files.push(file); });
        });
        return files;
    }

    function formatSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function iconFor(file) {
        var type = (file.type || '').toLowerCase();
        var name = (file.name || '').toLowerCase();
        if (type.indexOf('image/') === 0) return 'fa-regular fa-image';
        if (type.indexOf('audio/') === 0) return 'fa-solid fa-headphones';
        if (type.indexOf('video/') === 0) return 'fa-solid fa-film';
        if (name.slice(-4) === '.pdf') return 'fa-regular fa-file-pdf';
        if (name.indexOf('.doc') > -1) return 'fa-regular fa-file-word';
        if (name.indexOf('.xls') > -1 || name.indexOf('.csv') > -1) return 'fa-regular fa-file-excel';
        return 'fa-regular fa-file-lines';
    }

    function renderFiles(changedInput) {
        var files = allFiles();
        var total = files.reduce(function (sum, file) { return sum + file.size; }, 0);
        var oversized = files.some(function (file) { return file.size > maxEach; });

        if (files.length > maxFiles) {
            alert('Você pode enviar no máximo 4 arquivos.');
            if (changedInput) changedInput.value = '';
            files = allFiles();
        } else if (oversized) {
            alert('Cada arquivo pode ter no máximo 100 MB.');
            if (changedInput) changedInput.value = '';
            files = allFiles();
        } else if (total > maxTotal) {
            alert('O conjunto dos arquivos pode ter no máximo 200 MB.');
            if (changedInput) changedInput.value = '';
            files = allFiles();
        }

        fileList.innerHTML = '';
        files.forEach(function (file) {
            var li = document.createElement('li');
            li.className = 'file-item';

            var icon = document.createElement('i');
            icon.className = iconFor(file);

            var meta = document.createElement('div');
            meta.className = 'file-meta';

            var name = document.createElement('span');
            name.className = 'file-name';
            name.textContent = file.name;

            var size = document.createElement('span');
            size.className = 'file-size';
            size.textContent = formatSize(file.size);

            meta.appendChild(name);
            meta.appendChild(size);
            li.appendChild(icon);
            li.appendChild(meta);
            fileList.appendChild(li);
        });

        fileSummary.classList.toggle('visible', files.length > 0);
    }

    fileInputs.forEach(function (input) {
        if (input) input.addEventListener('change', function () { renderFiles(input); });
    });

    clearFiles.addEventListener('click', function () {
        fileInputs.forEach(function (input) { if (input) input.value = ''; });
        renderFiles();
    });

    ['dragenter', 'dragover'].forEach(function (eventName) {
        uploadZone.addEventListener(eventName, function (event) {
            event.preventDefault();
            uploadZone.classList.add('dragging');
        });
    });
    ['dragleave', 'drop'].forEach(function (eventName) {
        uploadZone.addEventListener(eventName, function (event) {
            event.preventDefault();
            uploadZone.classList.remove('dragging');
        });
    });
    uploadZone.addEventListener('drop', function (event) {
        if (!event.dataTransfer || !event.dataTransfer.files || !event.dataTransfer.files.length) return;
        try {
            document.getElementById('arquivos').files = event.dataTransfer.files;
            renderFiles(document.getElementById('arquivos'));
        } catch (e) {
            alert('Neste navegador, use o botão Selecionar arquivos.');
        }
    });

    phone.addEventListener('input', function () {
        var value = phone.value.replace(/\D/g, '').slice(0, 11);
        if (value.length > 10) {
            phone.value = '(' + value.slice(0, 2) + ') ' + value.slice(2, 7) + '-' + value.slice(7);
        } else if (value.length > 6) {
            phone.value = '(' + value.slice(0, 2) + ') ' + value.slice(2, 6) + '-' + value.slice(6);
        } else if (value.length > 2) {
            phone.value = '(' + value.slice(0, 2) + ') ' + value.slice(2);
        } else {
            phone.value = value;
        }
    });

    cnpj.addEventListener('input', function () {
        var value = cnpj.value.replace(/\D/g, '').slice(0, 14);
        value = value.replace(/^(\d{2})(\d)/, '$1.$2');
        value = value.replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3');
        value = value.replace(/\.(\d{3})(\d)/, '.$1/$2');
        value = value.replace(/(\d{4})(\d)/, '$1-$2');
        cnpj.value = value;
    });

    form.addEventListener('submit', function (event) {
        var files = allFiles();
        var total = files.reduce(function (sum, file) { return sum + file.size; }, 0);

        if (!form.checkValidity()) {
            event.preventDefault();
            form.reportValidity();
            return;
        }
        if (relato.value.trim().length < 20) {
            event.preventDefault();
            alert('Descreva um pouco mais de detalhes sobre o ocorrido.');
            relato.focus();
            return;
        }
        if (files.length > maxFiles || total > maxTotal || files.some(function (file) { return file.size > maxEach; })) {
            event.preventDefault();
            alert('Revise os limites dos anexos antes de enviar.');
            return;
        }

        submitButton.disabled = true;
        submitButton.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Enviando...';
    });
})();
</script>
</body>
</html>
