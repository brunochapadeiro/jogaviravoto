{
  // Endereço antigo (jogaviravoto): o nome precisa ser igual ao do Worker no painel do Cloudflare.
  // Este Worker guarda o placar e manda as páginas para o endereço novo, no mesmo caminho (os QR codes já impressos continuam valendo).
  // O site em si sai pelo Worker "vigieademocracia" (configuração em vigie/wrangler.jsonc).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jogaviravoto",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": { "NOVO_ENDERECO": "https://vigieademocracia.brunochapadeiro.workers.dev/" },
  "durable_objects": {
    "bindings": [{ "name": "PLACAR", "class_name": "Placar" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Placar"] }],
  "observability": { "enabled": true }
}
