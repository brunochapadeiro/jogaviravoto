{
  // Igual ao wrangler.jsonc da raiz (para quem configurou o deploy com --config vigie/wrangler.jsonc).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vigieademocracia",
  "main": "../src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [{ "name": "PLACAR", "class_name": "Placar" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Placar"] }],
  "observability": { "enabled": true }
}
